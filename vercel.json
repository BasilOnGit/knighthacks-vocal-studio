{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "env": {
    "NODE_OPTIONS": "--experimental-strip-types"
  },
  "services": {
    "api": {
      "root": "apps/api",
      "runtime": "node",
      "entrypoint": "src/server.js",
      "installCommand": "cd ../.. && npm ci"
    },
    "web": {
      "root": "apps/web",
      "framework": "vite",
      "installCommand": "cd ../.. && npm ci",
      "buildCommand": "npm run build",
      "outputDirectory": "dist"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
